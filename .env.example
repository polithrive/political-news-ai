OPENAI_API_KEY=
NEWS_API_KEY=
GNEWS_API_KEY=
NEWS_PROVIDER=newsapi
NEXT_PUBLIC_APP_URL=https://theanglereport.com
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# NEWS_PROVIDER=newsapi uses NEWS_API_KEY (local development).
# NEWS_PROVIDER=gnews uses GNEWS_API_KEY (production).
# Do not set both providers to run at once. There is no automatic fallback.

# Set to 1/true/yes/on to disable AI-generating API routes without a redeploy.
# Returns HTTP 503. Does not affect /api/news or snapshot persistence.
AI_DISABLED=

# Vercel Web Analytics (LP4) does not use an env var. Enable Web Analytics
# in the Vercel project dashboard. Custom events require the Pro plan.
